<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>MutopiaProbe</RootNamespace>
    <AssemblyName>MutopiaProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\CodeBrix.LilyPort\CodeBrix.LilyPort.csproj" />
    <!-- CodeBrix.LilyPort bundles its sub-assemblies with PrivateAssets="all", so they do not
         flow through the reference above; the Engine is named directly for FontAssets. -->
    <ProjectReference Include="..\..\..\src\CodeBrix.LilyPort.Engine\CodeBrix.LilyPort.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SVG-pages-to-PDF route and the PDFium rasterizer used for grading. These are
         TOOL dependencies (decision D52(a)): CodeBrix.LilyPort itself must never depend on
         the Html2Pdf chain, and this project is not referenced by anything that ships. -->
    <PackageReference Include="CodeBrix.PdfDocCreate.Html2Pdf.MitLicenseForever" Version="1.0.238.1192" />
    <PackageReference Include="CodeBrix.PdfRasterizer.MitLicenseForever" Version="1.0.238.1192" />
  </ItemGroup>

</Project>
