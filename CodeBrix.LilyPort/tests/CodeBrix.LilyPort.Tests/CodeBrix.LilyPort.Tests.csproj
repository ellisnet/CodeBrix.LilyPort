<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.49" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The facade bundles its sub-assemblies with PrivateAssets="all" (the D8 packing
    pattern), so they are deliberately NOT transitive to consumers. First light drives
    the engine directly to build its music and inspect the grobs it produced, so the
    test project references them explicitly. A consumer of the nuget does not need to:
    all four assemblies ship inside the one package.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.LilyPort\CodeBrix.LilyPort.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.LilyPort.Engine\CodeBrix.LilyPort.Engine.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.LilyPort.Backends\CodeBrix.LilyPort.Backends.csproj" />
  </ItemGroup>

  <!--
    First light engraves real music, so it needs a real Emmentaler to measure and to
    name glyphs from. These are the fonts this repo builds and ships from its own
    vendored mf/ sources, so this is an in-repo fixture, not an external dependency.
    AllFontMetrics probes a TestFonts folder beside the assembly.
  -->
  <ItemGroup>
    <None Include="..\..\assets\fonts\otf\emmentaler-20.otf"
          Link="TestFonts\emmentaler-20.otf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\otf\emmentaler-brace.otf"
          Link="TestFonts\emmentaler-brace.otf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The convert-ly parity corpus: what LilyPond's own convert-ly produced for 149 real
    input files, recorded by tools/convertlyprobe. ConvertLyParityTests replays them.
  -->
  <ItemGroup>
    <None Include="fixtures\convertly\*.json"
          Link="fixtures\convertly\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The abc2ly parity corpus: what LilyPond's own abc2ly produced for its eight
    regression files and ten probes written beside them, recorded by tools/abcprobe.
    AbcImporterParityTests replays them.
  -->
  <ItemGroup>
    <None Include="fixtures\abc\*.json"
          Link="fixtures\abc\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The midi2ly parity corpus: what LilyPond's own midi2ly produced for the ninety
    reference MIDI files this repo engraves, plus the option variants, recorded by
    tools/midi2lyprobe. MidiImporterParityTests replays them.
  -->
  <ItemGroup>
    <None Include="fixtures\midi2ly\*.json"
          Link="fixtures\midi2ly\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The musicxml2ly parity corpus: what LilyPond's own musicxml2ly produced for the 166
    convertible files of its MusicXML test suite plus 40 option variants, recorded by
    tools/musicxml2lyprobe. MusicXmlImporterParityTests replays them.

    The inputs are VENDORED beside the cases rather than inlined into them: 1.5 MB of XML
    repeated 206 times buys nothing. They are Reinhold Kainhofer's unofficial MusicXML
    Test Suite, MIT, with its LICENSE copied in beside them.
  -->
  <ItemGroup>
    <None Include="fixtures\musicxml\cases\*.json"
          Link="fixtures\musicxml\cases\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures\musicxml\inputs\*"
          Link="fixtures\musicxml\inputs\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
